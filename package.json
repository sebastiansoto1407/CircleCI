{
  "name": "circleci-demo-javascript",
  "version": "1.0.0",
  "private": true,
  "description": "Demostración académica de CI/CD con CircleCI y JavaScript",
  "scripts": {
    "build": "esbuild src/calculadora.js src/cli.js --bundle --platform=node --format=cjs --outdir=dist",
    "test": "node --test tests/calculadora.test.cjs",
    "test:ci": "node scripts/test-ci.mjs",
    "start": "node dist/cli.js 2 3",
    "demo:fail": "node scripts/demo.mjs fail",
    "demo:fix": "node scripts/demo.mjs fix"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}

